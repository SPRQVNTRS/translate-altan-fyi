    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.3.0",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.5",
    "@types/node": "^24.10.1",
    "@types/pg": "^8.15.6",
    "@types/react": "^19.2.14",
    "@types/react-dom": "19.2.3",
    "concurrently": "^9.2.1",
    "oxlint": "1.78.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.7.3",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.1"
  },
  "scripts": {
    "build": "cross-env NODE_ENV=production react-router build",
    "cli": "tsx ./cli/index.ts",
    "dev": "concurrently --kill-others --names \"web,worker\" -c \"cyan,magenta\" \"pnpm run dev:server\" \"pnpm run dev:worker\"",
    "dev:server": "tsx ./server.ts",
    "dev:worker": "tsx watch ./worker.ts",
    "drizzle:generate": "tsx node_modules/drizzle-kit/bin.cjs generate",
    "drizzle:migrate": "tsx node_modules/drizzle-kit/bin.cjs migrate",
    "drizzle:push": "tsx node_modules/drizzle-kit/bin.cjs push",
    "drizzle:seed": "tsx drizzle/seed.ts",
    "drizzle:studio": "tsx node_modules/drizzle-kit/bin.cjs studio",
    "drizzle:update": "tsx node_modules/drizzle-kit/bin.cjs generate && tsx node_modules/drizzle-kit/bin.cjs migrate",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "i18n:check": "node --import tsx --test tests/unit/i18n-locales.test.ts",
    "lint": "oxlint --max-warnings 0",
    "lint:fix": "oxlint --fix --max-warnings 0",
    "prepare": "git config core.hooksPath .githooks || true",
    "start": "cross-env NODE_ENV=production tsx ./server.ts",
    "test:integration": "node --import tsx --test --test-concurrency=1 \"tests/integration/**/*.test.ts\"",
    "test:unit": "node --import tsx --experimental-test-module-mocks --test \"tests/unit/**/*.test.ts\"",
    "typecheck": "react-router typegen && tsc",
    "worker": "tsx ./worker.ts"
  },
  "engines": {
    "node": ">=22.22.0"
  },
  "packageManager": "pnpm@11.1.1"
}
