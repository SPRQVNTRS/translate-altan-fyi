# translate.altan.fyi — every variable the app reads, with placeholder values only.
# Copy to .env and fill in. Nothing here is a real credential.

# --- Application ---------------------------------------------------------

# development | production | test. Production turns on the required-secret checks.
NODE_ENV=development
# The public origin of this instance. Used to build absolute links.
APP_URL=http://localhost:3000
# The port the Express server listens on.
PORT=3000
# The port the Vite dev-server HMR socket uses. Development only.
HMR_PORT=24678
# Pino log level: trace | debug | info | warn | error | fatal.
LOG_LEVEL=info
# Extra diagnostic output. Leave false unless you are chasing something.
DEBUG_MODE=false

# Reverse-proxy trust — controls Express `trust proxy`, so req.protocol/hostname/ip
# and the URL the @react-router/express adapter builds reflect X-Forwarded-* headers.
# REQUIRED behind a proxy in React Router v8: the CSRF check matches the browser
# Origin against request.url's host, so same-origin actions are aborted if this is off.
# Values: hop count (1 = single Traefik hop), true/false, or a CIDR/preset list.
# Default: 1 in production, off in development. Multi-proxy (e.g. Cloudflare -> Traefik) = 2.
# TRUST_PROXY=1

# --- Database ------------------------------------------------------------

# Postgres host. The `pg_trgm` extension must be available on this server.
DB_HOST=localhost
# Postgres port.
DB_PORT=5432
# Postgres role the app connects as.
DB_USER=postgres
# The password for that role.
DB_PASSWORD=postgres
# The database name. Created by you; the migrations fill it.
DB_NAME=translate_altan_fyi
# Set true when the server requires TLS (a managed Postgres usually does).
DB_SSL=false
# Maximum pooled connections.
DB_POOL_MAX=10
# Connections the pool keeps open while idle.
DB_POOL_MIN=2
# How long an idle connection is kept, in milliseconds.
DB_IDLE_TIMEOUT_MS=30000
# How long a caller waits for a connection, in milliseconds.
DB_CONNECTION_TIMEOUT_MS=5000

# --- Secrets -------------------------------------------------------------

# Signs the session cookie. REQUIRED in production, 32+ random bytes.
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-32-plus-random-bytes

# The single root secret behind the end-to-end-encrypted personal layer.
# REQUIRED in every deployed environment. Generate 32+ random bytes the same way.
#
# ONE variable, and two domain-separated subkeys derived from it
# (app/lib/e2ee/server-secrets.ts), because an operator asked for two
# independent secrets eventually reuses one for the other:
#   - the VERIFIER PEPPER, mixed into every stored `HMAC(pepper, authHash)`.
#     Held outside the database on purpose: a dumped `accounts` table cannot
#     then be replayed pass-the-hash against a live instance.
#   - the ENUMERATION SECRET, behind the deterministic dummy KDF descriptor
#     served for an unknown handle. Without it the pre-login descriptor
#     endpoint answers "does this handle have an account?" for anyone who asks.
#
# ROTATING IT IS A BREAKING OPERATIONAL CHANGE. Every stored verifier is
# invalidated (every account must recover) and every dummy salt moves.
#
# This secret can NOT decrypt anything. The data-encryption key is wrapped
# client-side under a passphrase-derived KEK the server never sees.
SERVER_SECRET=replace-with-32-plus-random-bytes

# REQUIRED IN PRODUCTION. The one-shot secret that lets the very FIRST account
# be created, before any invite exists to gate it. Generate with
# `openssl rand -hex 32`. Signup accepts it in place of an invite token, and
# only while `accounts` is still empty, so it invalidates itself the moment the
# first account is created and stays dead for the rest of the instance's life.
# There is no env var that can seed an account directly: the server never learns
# a passphrase, so only a real browser can derive the keys an account is made of.
# See .adr/0009-invite-only-accounts.md.
# ACCOUNT_BOOTSTRAP_TOKEN=

# Abuse guard: the pepper the anonymous rate-limit counter keys are hashed with.
# NOT REQUIRED. The pepper only has to be secret and stable, and SESSION_SECRET is
# already both in every deployed environment, so the guard falls back to it and then
# to a fixed development string. Set this only to rotate the two apart.
# Fallback chain: ABUSE_HASH_PEPPER -> SESSION_SECRET -> a development constant.
# ABUSE_HASH_PEPPER=

# Abuse guard: where to POST the operator alert when enrichment spend crosses the
# daily warning threshold or reaches the cap.
# NOT REQUIRED. With no URL the alert is written to the log at warn level instead,
# which is a complete alert in a development checkout or a self-hosted install.
# The send is fire and forget with a 5s timeout: it can never fail the request.
# ALERT_WEBHOOK_URL=

# --- Language model provider --------------------------------------------

# OPTIONAL. Without a key the app serves dictionary results only: no generated
# explanation and no generated example sentence. One OpenRouter key covers every
# task in the default model configuration.
OPENROUTER_API_KEY=your-openrouter-key-here
# OPTIONAL. A direct OpenAI key, used when a model route asks for one.
OPENAI_API_KEY=your-openai-key-here
# OPTIONAL. A direct Anthropic key, used when a model route asks for one.
ANTHROPIC_API_KEY=your-anthropic-key-here

# --- CLI and operations --------------------------------------------------

# The API key `pnpm cli` sends. Mint one with `pnpm cli api-key create`.
# TRANSLATE_API_KEY=
# The remote base URL `pnpm cli --prod` targets.
# TRANSLATE_PROD_URL=https://translate.altan.fyi
# Timezone for the container. Affects log timestamps and daily budget rollover.
# TZ=UTC

# --- Integration tests ---------------------------------------------------

# The API key tests/integration/ uses. Every case self-skips when it is unset.
# TEST_API_KEY=
# The base URL the integration suite targets. Defaults to http://localhost:3456.
# TEST_REMOTE_URL=
